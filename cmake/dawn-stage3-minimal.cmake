# Initial CMake cache for the first DAWN → RKLLM acceptance build.
#
# This build is deliberately server-only.  Audio, speech recognition, text to
# speech, WebUI, AEC, and every deterministic/side-effecting tool are separate
# later stages.  Pass this file via: cmake -C <this-file> -S <dawn-source> -B <build-dir>

set(SERVER_ONLY ON CACHE BOOL "No local audio capture or playback" FORCE)
set(ENABLE_TUI OFF CACHE BOOL "No terminal UI" FORCE)
